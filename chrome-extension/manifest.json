{
  "manifest_version": 3,
  "name": "Soniox Meet Transcription",
  "version": "1.0.0",
  "description": "Real-time transcription and translation for Google Meet using Soniox",

  "permissions": [
    "storage",
    "tabs",
    "tabCapture",
    "activeTab"
  ],

  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content/meet-content-script.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html"
  },

  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
