{
  "name": "@sun-asterisk/meeting-trans-poc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "pnpm --filter @sun-asterisk/meeting-trans-web dev",
    "dev:web": "pnpm --filter @sun-asterisk/meeting-trans-web dev",
    "dev:extension": "pnpm --filter @sun-asterisk/meeting-trans-browser dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @sun-asterisk/meeting-trans-web build",
    "build:extension": "pnpm --filter @sun-asterisk/meeting-trans-browser build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "sb:genTypes": "pnpm --filter @sun-asterisk/meeting-trans-web sb:genTypes",
    "sb:push": "pnpm --filter @sun-asterisk/meeting-trans-web sb:push",
    "db:migrate": "pnpm --filter @sun-asterisk/meeting-trans-web db:migrate",
    "db:reset": "pnpm --filter @sun-asterisk/meeting-trans-web db:reset",
    "migration:create": "pnpm --filter @sun-asterisk/meeting-trans-web migration:create"
  }
}
