# Soniox API
SONIOX_API_KEY=

# Soniox V4 - Semantic endpointing delay (optional)
# Controls how long to wait before finalizing endpoint. Lower = faster but may interrupt.
# MAX_ENDPOINT_DELAY_MS=500

# WebSocket Server
PORT=3001

# Timeout for idle Soniox connections to be closed (in milliseconds)
IDLE_TIMEOUT_MS=300000

# Logging (fatal, error, warn, info, debug, trace, silent)
LOG_LEVEL=info

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
