SONIOX_API_KEY=<SONIOX_API_KEY>

# Realtime Proxy Server (optional - if not set, uses direct Soniox connection)
# When using proxy, transcripts are saved server-side instead of from client
NEXT_PUBLIC_REALTIME_TRANSCRIBE_ENDPOINT=ws://localhost:3001

# Basic Auth credentials
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Supabase Local (via Supabase CLI: npx supabase start)
# Get keys from: npx supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Google OAuth (for Supabase Auth)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
